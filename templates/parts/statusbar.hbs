<footer class="fm-statusbar">
  <span>{{statusCount}}</span>
  {{#if statusPane}}
    <span class="fm-status-pane">{{statusPane}}</span>
  {{/if}}
  <div class="fm-kofi-wrap">
    {{! котёнок выглядывает из-за статус-бара при наведении на кнопку - дизайн «Ko-fi котёнок» }}
    <div class="fm-kofi-peek" aria-hidden="true">
      <span class="fm-kofi-heart h1"><svg width="11" height="11" viewBox="0 0 24 24" fill="#e8829c"><path d="M12 21s-7.5-4.6-10-9.2C0.4 8.4 2.6 4.5 6.2 4.5c2.2 0 3.9 1.3 4.8 3 0.9-1.7 2.6-3 4.8-3 3.6 0 5.8 3.9 4.2 7.3C19.5 16.4 12 21 12 21z"/></svg></span>
      <span class="fm-kofi-heart h2"><svg width="13" height="13" viewBox="0 0 24 24" fill="#e8829c"><path d="M12 21s-7.5-4.6-10-9.2C0.4 8.4 2.6 4.5 6.2 4.5c2.2 0 3.9 1.3 4.8 3 0.9-1.7 2.6-3 4.8-3 3.6 0 5.8 3.9 4.2 7.3C19.5 16.4 12 21 12 21z"/></svg></span>
      <span class="fm-kofi-heart h3"><svg width="8" height="8" viewBox="0 0 24 24" fill="#e8829c"><path d="M12 21s-7.5-4.6-10-9.2C0.4 8.4 2.6 4.5 6.2 4.5c2.2 0 3.9 1.3 4.8 3 0.9-1.7 2.6-3 4.8-3 3.6 0 5.8 3.9 4.2 7.3C19.5 16.4 12 21 12 21z"/></svg></span>
      <span class="fm-kofi-heart h4"><svg width="8" height="8" viewBox="0 0 24 24" fill="#e8829c"><path d="M12 21s-7.5-4.6-10-9.2C0.4 8.4 2.6 4.5 6.2 4.5c2.2 0 3.9 1.3 4.8 3 0.9-1.7 2.6-3 4.8-3 3.6 0 5.8 3.9 4.2 7.3C19.5 16.4 12 21 12 21z"/></svg></span>
      <div class="fm-kofi-cat">
        <div class="fm-kofi-cat-wiggle">
          <svg width="56" height="42" viewBox="0 0 56 42" fill="none">
            <path d="M12 20L14 5l11 8z" fill="#8a93a6"/>
            <path d="M44 20L42 5l-11 8z" fill="#8a93a6"/>
            <path d="M15.5 17l1.2-8 6.6 4.8z" fill="#e8a0b4"/>
            <path d="M40.5 17l-1.2-8-6.6 4.8z" fill="#e8a0b4"/>
            <ellipse cx="28" cy="30" rx="18" ry="16" fill="#9aa4b8"/>
            <ellipse cx="28" cy="34" rx="10" ry="8" fill="#c7cedb"/>
            <ellipse class="fm-cat-eye" cx="21" cy="27" rx="2.6" ry="2.6" fill="#1d222a"/>
            <ellipse class="fm-cat-eye" cx="35" cy="27" rx="2.6" ry="2.6" fill="#1d222a"/>
            <circle cx="22" cy="26" r="0.9" fill="#fff" opacity="0.9"/>
            <circle cx="36" cy="26" r="0.9" fill="#fff" opacity="0.9"/>
            <path d="M26.4 32.2h3.2L28 34.4z" fill="#e8829c"/>
            <path d="M28 34.4v1.6M28 36q-1.6 1.6-3.2 0.4M28 36q1.6 1.6 3.2 0.4" stroke="#5a6478" stroke-width="1.1" stroke-linecap="round" fill="none"/>
            <path d="M14 30q-5-1.4-9-0.6M14.4 33q-4.6 0.4-8.4 2M42 30q5-1.4 9-0.6M41.6 33q4.6 0.4 8.4 2" stroke="#7d8698" stroke-width="1" stroke-linecap="round" fill="none"/>
          </svg>
        </div>
      </div>
      <div class="fm-kofi-paws">
        <svg width="56" height="10" viewBox="0 0 56 10" fill="none">
          <ellipse cx="17" cy="9" rx="5.5" ry="4.2" fill="#c7cedb"/>
          <ellipse cx="39" cy="9" rx="5.5" ry="4.2" fill="#c7cedb"/>
          <path d="M15.2 6.8v3M18.8 6.8v3M37.2 6.8v3M40.8 6.8v3" stroke="#8a93a6" stroke-width="0.9" stroke-linecap="round"/>
        </svg>
      </div>
    </div>
    <a class="fm-kofi" href="https://ko-fi.com/dungeonslab" target="_blank" rel="noopener"
       data-tooltip="{{localize "FILE_MANAGER_DUNGEONS_LAB.Kofi.Tooltip"}}">
      {{! официальный знак Ko-fi (Simple Icons, CC0) }}
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M11.351 2.715c-2.7 0-4.986.025-6.83.26C2.078 3.285 0 5.154 0 8.61c0 3.506.182 6.13 1.585 8.493 1.584 2.701 4.233 4.182 7.662 4.182h.83c4.209 0 6.494-2.234 7.637-4a9.5 9.5 0 0 0 1.091-2.338C21.792 14.688 24 12.22 24 9.208v-.415c0-3.247-2.13-5.507-5.792-5.87-1.558-.156-2.65-.208-6.857-.208m0 1.947c4.208 0 5.09.052 6.571.182 2.624.311 4.13 1.584 4.13 4v.39c0 2.156-1.792 3.844-3.87 3.844h-.935l-.156.649c-.208 1.013-.597 1.818-1.039 2.546-.909 1.428-2.545 3.064-5.922 3.064h-.805c-2.571 0-4.831-.883-6.078-3.195-1.09-2-1.298-4.155-1.298-7.506 0-2.181.857-3.402 3.012-3.714 1.533-.233 3.559-.26 6.39-.26m6.547 2.287c-.416 0-.65.234-.65.546v2.935c0 .311.234.545.65.545 1.324 0 2.051-.754 2.051-2s-.727-2.026-2.052-2.026m-10.39.182c-1.818 0-3.013 1.48-3.013 3.142 0 1.533.858 2.857 1.949 3.897.727.701 1.87 1.429 2.649 1.896a1.47 1.47 0 0 0 1.507 0c.78-.467 1.922-1.195 2.623-1.896 1.117-1.039 1.974-2.364 1.974-3.897 0-1.662-1.247-3.142-3.039-3.142-1.065 0-1.792.545-2.338 1.298-.493-.753-1.246-1.298-2.312-1.298"/>
      </svg>
      <span>Ko-fi</span>
    </a>
  </div>
  <span class="fm-spacer"></span>
  {{#if phrase}}
    <span class="fm-phrase" data-action="phraseClick">{{phrase}}</span>
  {{/if}}
  <span class="fm-spacer"></span>
  <span>{{statusSelected}}</span>
  {{#if showSelect}}
    <button type="button" class="fm-btn accent fm-select-btn" data-action="confirmSelect"
            {{#if selectDisabled}}disabled{{/if}}>
      <i class="fa-solid fa-check"></i>
      <span>{{selectLabel}}</span>
    </button>
  {{/if}}
</footer>
